# Copy this file to .env and fill in the key for whichever provider you want to use.
# You only need ONE key — leave the others blank.

# xAI Grok  → https://console.x.ai/
XAI_API_KEY=

# MiniMax M3  → https://www.minimaxi.com/
MINIMAX_API_KEY=

# Groq (free tier, very fast)  → https://console.groq.com/
GROQ_API_KEY=

# Google Gemini (free tier)  → https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Ollama (local, free) — no key needed, just install Ollama and pull a model:
#   ollama pull qwen2.5:14b
